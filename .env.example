# ---------------------------------------------------------------- runtime
NODE_ENV=development
LOG_LEVEL=info
HTTP_PORT=3000

# ---------------------------------------------------------------- database
DATABASE_URL=postgres://bolsync:change-me@localhost:5432/bolsync
DB_POOL_MAX=10

# ---------------------------------------------------------------- bol.com
# Seller Dashboard > Instellingen > API Instellingen > Client credentials.
# These are only used by scripts/seed-demo.js; in production the credentials
# live encrypted in tenants.bol_client_secret_enc.
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=

BOL_TOKEN_URL=https://login.bol.com/token
BOL_API_BASE=https://api.bol.com

# v11 = synchronous PATCH (preferred). v10 = legacy PUT + process status polling.
BOL_OFFERS_API_VERSION=v11

# Refresh the token this many seconds before it expires.
# The token lives 299s; never request one per API call (bol bans the IP for that).
BOL_TOKEN_REFRESH_MARGIN_SEC=59

# AES-256-GCM key for the stored client secrets. 32 bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BOL_CRED_ENC_KEY=

# ---------------------------------------------------------------- rate limits
# Percentage of bol's published limit this service is allowed to use.
# The limit is per seller account, not per application: leave room for the
# client's other tools (repricer, ERP, their own scripts).
RATE_BUDGET_PCT=60
HTTP_TIMEOUT_MS=15000

# ---------------------------------------------------------------- worker
WORKER_ID=worker-1
WORKER_CONCURRENCY=8
WORKER_CLAIM_BATCH=25
WORKER_POLL_INTERVAL_MS=500
JOB_MAX_ATTEMPTS=6
JOB_BACKOFF_BASE_MS=1000
JOB_BACKOFF_MAX_MS=300000
JOB_STUCK_AFTER_MS=120000

# ---------------------------------------------------------------- safety rules
SAFETY_BUFFER_ABS=2
SAFETY_BUFFER_PCT=0
SAFETY_MIN_PUBLISH=1
SAFETY_MAX_PUBLISH=999
STOCK_DELTA_THRESHOLD=2

# Do not plan anything from source data older than this.
# A dead source that answers "0 stock" can pull a whole catalogue offline.
SOURCE_STALE_AFTER_MIN=30

# Stop the queue if more than this share of the catalogue drops to zero in one pass.
BULK_DROP_GUARD_PCT=20

# ---------------------------------------------------------------- price rules
PRICE_MARKUP_PCT=0
PRICE_ROUNDING=cent
PRICE_MAX_CHANGE_PCT=25
PRICE_MIN=1
PRICE_MAX=9999

# ---------------------------------------------------------------- schedules
RECONCILE_INTERVAL_MIN=15
RECONCILE_FULL_AT=03:30
PULL_SOURCE_INTERVAL_MIN=10

# ---------------------------------------------------------------- source
# woocommerce | shopify | csv
SOURCE_TYPE=woocommerce
SOURCE_BASE_URL=https://example.nl
SOURCE_API_KEY=
SOURCE_API_SECRET=
SOURCE_CSV_PATH=./data/feed.csv
SOURCE_WEBHOOK_SECRET=

# Which feed column holds what. Dutch feeds name these in Dutch and no two
# suppliers agree, so this is configuration rather than a guess.
SOURCE_COLUMN_MAP={"sku":"sku","ean":"ean","stock":"voorraad","price":"prijs"}
